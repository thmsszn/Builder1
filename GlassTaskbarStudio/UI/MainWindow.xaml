<Window x:Class="GlassTaskbarStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GlassTaskbarStudio.UI.Controls"
        Title="Glass Taskbar Studio" Width="1200" Height="800" MinWidth="1000" MinHeight="620"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#FF090C15" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <!-- aurora backdrop -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Canvas.Left="-200" Canvas.Top="-260">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#665B5BFF" Offset="0"/><GradientStop Color="#005B5BFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="700" Height="700" Canvas.Right="-180" Canvas.Top="-200">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#55C026D3" Offset="0"/><GradientStop Color="#00C026D3" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" Canvas.Left="300" Canvas.Bottom="-520">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#4406B6D4" Offset="0"/><GradientStop Color="#0006B6D4" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Margin="20,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="24" Height="24"/>
                    <TextBlock Text="Glass Taskbar Studio" FontSize="13.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Border Margin="10,1,0,0" CornerRadius="6" Padding="6,1,6,2" Background="#26FFFFFF" VerticalAlignment="Center">
                        <TextBlock Text="2.0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" Click="Minimize_Click" ToolTip="Minimize">
                        <Rectangle Width="11" Height="1.4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Tag="close" Click="Close_Click" ToolTip="Hide to tray">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- navigation -->
                <Grid Margin="14,6,6,16">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="NavPanel"/>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,12" Margin="0" CornerRadius="16">
                        <StackPanel>
                            <TextBlock Text="{Binding OsName}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Text="Effects run while this app is in the tray."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- content -->
                <Grid Grid.Column="1" Margin="8,6,24,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14" CornerRadius="20">
                        <c:TaskbarPreview Settings="{Binding Draft}" Height="212" CornerRadius="20"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                        <ContentControl x:Name="PageHost" Focusable="False"/>
                    </ScrollViewer>

                    <!-- footer -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,12" Margin="0,12,0,0" CornerRadius="18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" Margin="0,0,10,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#FF34D399"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Fill" Value="#FFFBBF24"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="All changes applied"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Text" Value="Unapplied changes"/><Setter Property="Foreground" Value="#FFFBBF24"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Toast}" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" ToolTip="Show every change on your real taskbar while you drag sliders">
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LiveApply, Mode=TwoWay}" Width="40" Height="22"/>
                                    <TextBlock Text="Live apply" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="Restart Explorer to finish" Style="{StaticResource GlassButton}" Padding="12,5" FontSize="12" Margin="18,0,0,0"
                                        Command="{Binding RestartExplorerCommand}" Visibility="{Binding RestartNeeded, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Reset to default" Style="{StaticResource GlassButton}" Command="{Binding ResetCommand}" Margin="0,0,10,0"/>
                                <Button Content="Restore Windows taskbar" Style="{StaticResource GlassButton}" Command="{Binding RestoreCommand}" Margin="0,0,10,0"/>
                                <Button Content="Apply" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" Padding="30,9"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
