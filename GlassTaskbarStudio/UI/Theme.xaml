<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:u="clr-namespace:GlassTaskbarStudio.UI"
                    xmlns:c="clr-namespace:GlassTaskbarStudio.UI.Controls">

    <!-- ============ Converters ============ -->
    <u:EnumMatchConverter x:Key="EnumMatch"/>
    <u:HexBrushConverter x:Key="HexBrush"/>
    <u:BadgeBrushConverter x:Key="BadgeBrush"/>
    <u:NotEmptyToVisibilityConverter x:Key="NotEmptyVis"/>
    <u:InverseBoolConverter x:Key="InverseBool"/>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- ============ Palette ============ -->
    <Color x:Key="AccentA">#FF8B7CFF</Color>
    <Color x:Key="AccentB">#FF3FB0FF</Color>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F6FF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA6C4"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#FF6F7B99"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentA}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentB}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1EFFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#40FFFFFF" Offset="0"/>
        <GradientStop Color="#10FFFFFF" Offset="0.6"/>
        <GradientStop Color="#18FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============ Icons (24x24 path data) ============ -->
