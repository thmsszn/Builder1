    <Geometry x:Key="IconPalette">M12,3c-4.97,0-9,4.03-9,9s4.03,9,9,9c0.83,0,1.5-0.67,1.5-1.5c0-0.39-0.15-0.74-0.39-1.01c-0.23-0.26-0.38-0.61-0.38-0.99c0-0.83,0.67-1.5,1.5-1.5H16c2.76,0,5-2.24,5-5C21,6.58,16.97,3,12,3z</Geometry>
    <Geometry x:Key="IconLayout">M10,18h5V5h-5V18z M4,18h5V5H4V18z M16,5v13h5V5H16z</Geometry>
    <Geometry x:Key="IconMotion">M8,5v14l11-7L8,5z</Geometry>
    <Geometry x:Key="IconSparkle">M19,9l1.25-2.75L23,5l-2.75-1.25L19,1l-1.25,2.75L15,5l2.75,1.25L19,9z M11.5,9.5L9,4L6.5,9.5L1,12l5.5,2.5L9,20l2.5-5.5L17,12L11.5,9.5z M19,15l-1.25,2.75L15,19l2.75,1.25L19,23l1.25-2.75L23,19l-2.75-1.25L19,15z</Geometry>
