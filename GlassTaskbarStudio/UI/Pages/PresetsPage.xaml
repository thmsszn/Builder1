<UserControl x:Class="GlassTaskbarStudio.UI.Pages.PresetsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:GlassTaskbarStudio.UI.Controls">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PresetCards.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Presets" Style="{StaticResource H1}" Margin="0,0,0,4"/>
        <TextBlock Text="Click a card to switch instantly. A preset sets the look; your icon alignment, size and motion settings are kept." Style="{StaticResource Body}" Margin="0,0,0,16"/>
        <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetCard}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Your own looks" Style="{StaticResource H2}"/>
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,12" Text="Tweak anything, then export your look as a file to share or back up - or import one."/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Export current look" Style="{StaticResource GlassButton}" Command="{Binding ExportCommand}" Margin="0,0,10,0"/>
                    <Button Content="Import a look" Style="{StaticResource GlassButton}" Command="{Binding ImportCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
