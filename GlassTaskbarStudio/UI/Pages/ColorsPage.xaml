<UserControl x:Class="GlassTaskbarStudio.UI.Pages.ColorsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:GlassTaskbarStudio.UI.Controls">
    <StackPanel>
        <TextBlock Text="Colors" Style="{StaticResource H1}" Margin="0,0,0,4"/>
        <TextBlock Text="Tint the glass, light its edge, color its shadow." Style="{StaticResource Body}" Margin="0,0,0,16"/>
        <WrapPanel>
            <Border Style="{StaticResource Card}" Width="424" Margin="0,0,14,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Glass tint" Style="{StaticResource H2}"/>
                        <Border Margin="10,0,0,0" CornerRadius="6" Padding="6,1,6,2" Background="#FF23A65E" VerticalAlignment="Center"><TextBlock Text="NATIVE" FontSize="9.5" FontWeight="Bold" Foreground="White"/></Border>
                    </StackPanel>
                    <c:ColorPicker Hex="{Binding Draft.TintHex, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="424" Margin="0,0,14,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Border and rim light" Style="{StaticResource H2}"/>
                        <Border Margin="10,0,0,0" CornerRadius="6" Padding="6,1,6,2" Background="#FF7C4DE0" VerticalAlignment="Center"><TextBlock Text="OVERLAY" FontSize="9.5" FontWeight="Bold" Foreground="White"/></Border>
                    </StackPanel>
                    <c:ColorPicker Hex="{Binding Draft.BorderHex, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="424" Margin="0,0,14,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Shadow and glow" Style="{StaticResource H2}"/>
                        <Border Margin="10,0,0,0" CornerRadius="6" Padding="6,1,6,2" Background="#FF7C4DE0" VerticalAlignment="Center"><TextBlock Text="OVERLAY" FontSize="9.5" FontWeight="Bold" Foreground="White"/></Border>
                    </StackPanel>
                    <c:ColorPicker Hex="{Binding Draft.ShadowHex, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </WrapPanel>
    </StackPanel>
</UserControl>
