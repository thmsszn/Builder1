<UserControl x:Class="GlassTaskbarStudio.UI.Pages.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:GlassTaskbarStudio.UI.Controls">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PresetCards.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Dashboard" Style="{StaticResource H1}" Margin="0,0,0,4"/>
        <TextBlock Text="Your taskbar, reimagined. Pick a look - it is applied to your real taskbar instantly." Style="{StaticResource Body}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0">
                <StackPanel>
                    <TextBlock Text="ACTIVE THEME" Style="{StaticResource Caption}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ActiveTheme}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,4,0,2"/>
                    <TextBlock Style="{StaticResource Body}" Text="Unapplied changes - press Apply to put them on your taskbar.">
                        <TextBlock.Visibility><Binding Path="IsDirty" Converter="{StaticResource BoolVis}"/></TextBlock.Visibility>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TASKBAR EFFECTS" Style="{StaticResource Caption}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding EngineStatus}" Style="{StaticResource Body}" Foreground="{StaticResource TextPrimary}" Margin="0,6,12,0"/>
                        <TextBlock Text="{Binding OsName}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EffectsEnabled, Mode=TwoWay}" VerticalAlignment="Top" ToolTip="Off = original Windows taskbar"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Text="Presets" Style="{StaticResource H2}" Margin="2,6,0,10"/>
        <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetCard}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
