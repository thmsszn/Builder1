<UserControl x:Class="GlassTaskbarStudio.UI.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <StackPanel>
        <ItemsControl x:Name="Swatches" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="26" Height="26" Margin="0,0,7,7" Cursor="Hand" Tag="{Binding}" Click="Swatch_Click" ToolTip="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ring" CornerRadius="13" BorderThickness="2" BorderBrush="#33FFFFFF" Padding="2">
                                    <Ellipse Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexBrush}}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="BorderBrush" Value="White"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="Preview" Width="34" Height="34" CornerRadius="10" BorderThickness="1" BorderBrush="#40FFFFFF"/>
            <TextBox x:Name="HexBox" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource GlassTextBox}" MaxLength="9" VerticalContentAlignment="Center"
                     LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown"/>
        </Grid>

        <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Hue" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <Slider x:Name="HueSlider" Grid.Column="1" Style="{StaticResource GlassSlider}" Width="Auto" Maximum="360" ValueChanged="Hsv_Changed"/>
        </Grid>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Sat" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <Slider x:Name="SatSlider" Grid.Column="1" Style="{StaticResource GlassSlider}" Width="Auto" ValueChanged="Hsv_Changed"/>
        </Grid>
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Val" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <Slider x:Name="ValSlider" Grid.Column="1" Style="{StaticResource GlassSlider}" Width="Auto" ValueChanged="Hsv_Changed"/>
        </Grid>
    </StackPanel>
</UserControl>
