    <Compile Include="..\GlassTaskbarStudio\Core\TaskbarSettings.cs" Link="Core\TaskbarSettings.cs" />
    <Compile Include="..\GlassTaskbarStudio\Core\Presets.cs" Link="Core\Presets.cs" />
    <Compile Include="..\GlassTaskbarStudio\Core\Capabilities.cs" Link="Core\Capabilities.cs" />
    <Compile Include="..\GlassTaskbarStudio\Core\LayoutCalculator.cs" Link="Core\LayoutCalculator.cs" />
