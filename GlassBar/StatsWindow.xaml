<Window x:Class="GlassBar.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Width="360" Height="540" FontFamily="Segoe UI" Foreground="White"
        Deactivated="Window_Deactivated">
    <Grid>
        <Border IsHitTestVisible="False" BorderThickness="1" CornerRadius="22" BorderBrush="#60FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#0AFFFFFF" Offset="0.4"/>
                    <GradientStop Color="#30000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <StackPanel Margin="20,16">
            <TextBlock Text="System-Überblick" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>

            <TextBlock x:Name="CpuLabel" Margin="0,12,0,3" FontSize="12"/>
            <Canvas x:Name="CpuCanvas" Width="320" Height="44" ClipToBounds="True" Background="#22000000">
                <Polygon x:Name="CpuArea" Fill="#557CC8FF" Stroke="#FF7CC8FF" StrokeThickness="1.5"/>
            </Canvas>

            <TextBlock x:Name="RamLabel" Margin="0,10,0,3" FontSize="12"/>
            <Canvas x:Name="RamCanvas" Width="320" Height="44" ClipToBounds="True" Background="#22000000">
                <Polygon x:Name="RamArea" Fill="#55D18CFF" Stroke="#FFD18CFF" StrokeThickness="1.5"/>
            </Canvas>

            <TextBlock x:Name="NetLabel" Margin="0,10,0,0" FontSize="12"/>

            <TextBlock Text="Top-Prozesse" Margin="0,12,0,3" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProcText" FontSize="12" Opacity="0.9" LineHeight="18"/>

            <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="10" Background="#22000000" BorderBrush="#30FFFFFF" BorderThickness="1">
                <TextBlock x:Name="InsightText" TextWrapping="Wrap" FontSize="12"/>
            </Border>

            <Button x:Name="AiButton" Style="{StaticResource GlossButton}" Height="36" Margin="0,12,0,0" Click="Ai_Click"
                    HorizontalContentAlignment="Center" Content="✨ KI-Analyse (Claude)"/>
            <TextBlock x:Name="AiText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Opacity="0.95"/>
        </StackPanel>
    </Grid>
</Window>
