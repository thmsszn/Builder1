<Window x:Class="GlassBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBar" Height="68" Width="1200"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="Transparent" AllowDrop="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Drop="Window_Drop">
    <Grid>
        <!-- Zentrierte, schwebende Glas-Pille: wächst mit dem Inhalt -->
        <Border x:Name="Pill" HorizontalAlignment="Center" Margin="0,5,0,7" CornerRadius="26" BorderThickness="1" Padding="12,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#44FFFFFF" Offset="0"/>
                    <GradientStop Color="#12FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#06000000" Offset="0.5"/>
                    <GradientStop Color="#22000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#C0FFFFFF" Offset="0"/>
                    <GradientStop Color="#34FFFFFF" Offset="0.55"/>
                    <GradientStop Color="#1CFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Start / Suche / Aufgabenansicht -->
                <Button Style="{StaticResource FlatGlass}" Width="46" Height="46" Click="Start_Click" ToolTip="Start">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="20" Height="20">
                            <Path Fill="#FF9AD8FF" Data="M0,2.5 L8.5,1.3 L8.5,9 L0,9 Z"/>
                            <Path Fill="#FF9AD8FF" Data="M9.7,1.1 L20,-0.3 L20,9 L9.7,9 Z"/>
                            <Path Fill="#FF9AD8FF" Data="M0,10.2 L8.5,10.2 L8.5,17.8 L0,16.6 Z"/>
                            <Path Fill="#FF9AD8FF" Data="M9.7,10.2 L20,10.2 L20,20.3 L9.7,18.9 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource FlatGlass}" Width="42" Height="46" Click="Search_Click" ToolTip="Suche">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="20" Height="20">
                            <Ellipse Canvas.Left="2" Canvas.Top="2" Width="12" Height="12" Stroke="White" StrokeThickness="2"/>
                            <Line X1="12.5" Y1="12.5" X2="18" Y2="18" Stroke="White" StrokeThickness="2" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Style="{StaticResource FlatGlass}" Width="42" Height="46" Click="TaskView_Click" ToolTip="Aufgabenansicht">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="20" Height="20">
                            <Rectangle Canvas.Left="1" Canvas.Top="4" Width="12" Height="10" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="1.8"/>
                            <Rectangle Canvas.Left="7" Canvas.Top="8" Width="12" Height="10" RadiusX="2" RadiusY="2" Stroke="White" StrokeThickness="1.8" Fill="#30FFFFFF"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Border Width="1" Height="26" Margin="8,0" Background="#40FFFFFF"/>

                <!-- Angeheftete Apps -->
                <ItemsControl x:Name="PinnedList" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatGlass}" Width="46" Height="46" ToolTip="{Binding Name}" Click="Pinned_Click"
                                    PreviewMouseDown="Pinned_MouseDown" MouseEnter="Pinned_Enter" MouseLeave="Preview_Leave">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Von Leiste lösen" Click="Unpin_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="46" Height="46">
                                    <Border CornerRadius="13" Margin="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#30BFE4FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="3" Margin="0,0,0,2" CornerRadius="2" Background="{StaticResource Accent}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Width" Value="5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Width" Value="16"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Laufende Fenster (nur Icons, Titel im Tooltip/Vorschau) -->
                <Border x:Name="RunningSep" Width="1" Height="26" Margin="8,0" Background="#40FFFFFF" Visibility="Collapsed"/>
                <ItemsControl x:Name="RunningList" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatGlass}" Width="46" Height="46" ToolTip="{Binding Title}" Click="Task_Click"
                                    PreviewMouseDown="Task_MouseDown" MouseEnter="Task_Enter" MouseLeave="Preview_Leave">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Minimieren" Click="Task_Minimize"/>
                                        <MenuItem Header="Schließen" Click="Task_Close"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Grid Width="46" Height="46">
                                    <Border CornerRadius="13" Margin="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#30BFE4FF"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="3" Margin="0,0,0,2" CornerRadius="2" Background="{StaticResource Accent}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Width" Value="5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Width" Value="16"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Width="1" Height="26" Margin="8,0" Background="#40FFFFFF"/>

                <!-- Status / Quick Actions / Uhr -->
                <Border x:Name="StatsPanel" Padding="8,0" Height="46" Background="#01000000" Cursor="Hand" MouseLeftButtonUp="Stats_Click" ToolTip="System-Details &amp; KI-Analyse">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CpuText" FontSize="12" Margin="0,0,10,0" Opacity="0.9"/>
                        <TextBlock x:Name="RamText" FontSize="12" Margin="0,0,10,0" Opacity="0.9"/>
                        <TextBlock x:Name="BatText" FontSize="12" Opacity="0.9"/>
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource FlatGlass}" Width="38" Height="46" Click="VolMute_Click" MouseWheel="Volume_Wheel" ToolTip="Lautstärke (Mausrad) / Stumm (Klick)">
                    <TextBlock Text="🔊" FontSize="15"/>
                </Button>
                <Button Style="{StaticResource FlatGlass}" Width="38" Height="46" Click="Settings_Click" ToolTip="Einstellungen">
                    <TextBlock Text="⚙" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource FlatGlass}" Width="38" Height="46" Click="ShowDesktop_Click" ToolTip="Desktop anzeigen">
                    <TextBlock Text="🖥" FontSize="15"/>
                </Button>
                <Button x:Name="ClockButton" Style="{StaticResource FlatGlass}" Width="74" Height="46" Click="Clock_Click" ToolTip="Benachrichtigungen">
                    <TextBlock x:Name="ClockText" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
