<Window x:Class="GlassBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBar" Height="56" Width="1200"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Background="Transparent" AllowDrop="True"
        FontFamily="Segoe UI" Foreground="White" UseLayoutRounding="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Drop="Window_Drop">
    <Grid>
        <!-- Glas-Glanz: heller oberer Bereich, dunklerer unterer Bereich -->
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#48FFFFFF" Offset="0"/>
                    <GradientStop Color="#16FFFFFF" Offset="0.5"/>
                    <GradientStop Color="#06000000" Offset="0.5"/>
                    <GradientStop Color="#30000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border x:Name="EdgeLine" IsHitTestVisible="False" VerticalAlignment="Top" Height="1" Background="#99FFFFFF"/>

        <DockPanel Margin="8,6">
            <!-- Rechte Seite -->
            <Button DockPanel.Dock="Right" x:Name="ClockButton" Style="{StaticResource GlossButton}" Width="86" Click="Clock_Click" ToolTip="Benachrichtigungen">
                <TextBlock x:Name="ClockText" TextAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource GlossButton}" Width="30" Click="ShowDesktop_Click" ToolTip="Desktop anzeigen">
                <TextBlock Text="🖥" FontSize="15" HorizontalAlignment="Center"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource GlossButton}" Width="30" Click="Settings_Click" ToolTip="Einstellungen">
                <TextBlock Text="⚙" FontSize="16" HorizontalAlignment="Center"/>
            </Button>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="VolumePanel" MouseWheel="Volume_Wheel">
                <Button Style="{StaticResource GlossButton}" Width="28" Click="VolDown_Click" ToolTip="Leiser"><TextBlock Text="🔉" HorizontalAlignment="Center"/></Button>
                <Button Style="{StaticResource GlossButton}" Width="28" Click="VolMute_Click" ToolTip="Stumm"><TextBlock Text="🔇" HorizontalAlignment="Center"/></Button>
                <Button Style="{StaticResource GlossButton}" Width="28" Click="VolUp_Click" ToolTip="Lauter"><TextBlock Text="🔊" HorizontalAlignment="Center"/></Button>
            </StackPanel>
            <Border DockPanel.Dock="Right" x:Name="StatsPanel" Margin="2,0" Padding="10,0" CornerRadius="10" BorderThickness="1" BorderBrush="#30FFFFFF" Background="#18000000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CpuText" FontSize="12" Margin="0,0,10,0" ToolTip="CPU-Auslastung"/>
                    <TextBlock x:Name="RamText" FontSize="12" Margin="0,0,10,0" ToolTip="RAM-Auslastung"/>
                    <TextBlock x:Name="BatText" FontSize="12" ToolTip="Akku"/>
                </StackPanel>
            </Border>

            <!-- Linke Seite -->
            <Button DockPanel.Dock="Left" Style="{StaticResource GlossButton}" Width="42" Click="Start_Click" ToolTip="Start">
                <Viewbox Width="18" Height="18" HorizontalAlignment="Center">
                    <Canvas Width="20" Height="20">
                        <Path Fill="#FF9AD8FF" Data="M0,2.5 L8.5,1.3 L8.5,9 L0,9 Z"/>
                        <Path Fill="#FF9AD8FF" Data="M9.7,1.1 L20,-0.3 L20,9 L9.7,9 Z"/>
                        <Path Fill="#FF9AD8FF" Data="M0,10.2 L8.5,10.2 L8.5,17.8 L0,16.6 Z"/>
                        <Path Fill="#FF9AD8FF" Data="M9.7,10.2 L20,10.2 L20,20.3 L9.7,18.9 Z"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource GlossButton}" Width="34" Click="Search_Click" ToolTip="Suche">
                <TextBlock Text="🔍" FontSize="14" HorizontalAlignment="Center"/>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource GlossButton}" Width="34" Click="TaskView_Click" ToolTip="Aufgabenansicht">
                <TextBlock Text="❐" FontSize="16" HorizontalAlignment="Center"/>
            </Button>
            <Border DockPanel.Dock="Left" Width="1" Margin="6,6" Background="#40FFFFFF"/>

            <ItemsControl DockPanel.Dock="Left" x:Name="PinnedList">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlossButton}" Width="40" ToolTip="{Binding Name}" Click="Pinned_Click" PreviewMouseDown="Pinned_MouseDown">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Von Leiste lösen" Click="Unpin_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Border CornerRadius="10" Margin="-6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#38BFE4FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Image Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Height="3" Margin="0,0,0,-5" CornerRadius="2" Background="{StaticResource Accent}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Width" Value="6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Width" Value="18"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border DockPanel.Dock="Left" Width="1" Margin="6,6" Background="#40FFFFFF"/>

            <!-- Laufende Fenster (füllt den Rest) -->
            <ItemsControl x:Name="RunningList" SizeChanged="RunningList_SizeChanged">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlossButton}" Width="{Binding ItemWidth}" ToolTip="{Binding Title}" Click="Task_Click" PreviewMouseDown="Task_MouseDown">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Minimieren" Click="Task_Minimize"/>
                                    <MenuItem Header="Schließen" Click="Task_Close"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid>
                                <Border CornerRadius="10" Margin="-6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#38BFE4FF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="2,0,0,0"/>
                                    <TextBlock Text="{Binding Title}" Margin="8,0,2,0" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <Border VerticalAlignment="Bottom" Height="3" Margin="6,0,6,-5" CornerRadius="2" Background="{StaticResource Accent}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Grid>
</Window>
