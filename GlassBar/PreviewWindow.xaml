<Window x:Class="GlassBar.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Background="Transparent" Width="300" Height="200" FontFamily="Segoe UI" Foreground="White">
    <Grid>
        <Border IsHitTestVisible="False" BorderThickness="1" CornerRadius="18" BorderBrush="#50FFFFFF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#38FFFFFF" Offset="0"/>
                    <GradientStop Color="#0CFFFFFF" Offset="0.45"/>
                    <GradientStop Color="#28000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <TextBlock x:Name="TitleText" Margin="14,9,14,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
