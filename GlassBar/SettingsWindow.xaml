<Window x:Class="GlassBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GlassBar – Einstellungen" Width="360" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF14182A" Foreground="White" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="GlassBar" FontSize="22" FontWeight="SemiBold" Foreground="#FF9AD8FF"/>
        <TextBlock Text="Deine neue gläserne Taskleiste" Opacity="0.6" Margin="0,0,0,14"/>

        <CheckBox x:Name="AutoStartBox" Content="Mit Windows starten (Autostart)" Foreground="White" Margin="0,4"/>
        <CheckBox x:Name="HideBox" Content="Windows-Taskleiste ausblenden" Foreground="White" Margin="0,4"/>
        <CheckBox x:Name="StatsBox" Content="CPU / RAM / Akku anzeigen" Foreground="White" Margin="0,4"/>
        <CheckBox x:Name="Clock24Box" Content="24-Stunden-Uhr" Foreground="White" Margin="0,4"/>

        <TextBlock Text="Position" Margin="0,12,0,4"/>
        <ComboBox x:Name="PosBox">
            <ComboBoxItem Content="Unten"/>
            <ComboBoxItem Content="Oben"/>
        </ComboBox>

        <TextBlock Text="Glasfarbe" Margin="0,12,0,4"/>
        <ComboBox x:Name="TintBox"/>

        <TextBlock Text="Farbintensität" Margin="0,12,0,4"/>
        <Slider x:Name="AlphaSlider" Minimum="0" Maximum="230"/>

        <TextBlock Margin="0,14,0,0" Opacity="0.55" TextWrapping="Wrap" FontSize="11"
                   Text="Tipp: Dateien (.exe, Verknüpfungen) per Drag &amp; Drop auf die Leiste ziehen, um sie anzuheften. Rechtsklick auf ein Symbol zum Lösen."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Übernehmen" Width="100" Padding="0,5" Click="Apply_Click" Margin="0,0,8,0"/>
            <Button Content="Schließen" Width="80" Padding="0,5" Click="Close_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
